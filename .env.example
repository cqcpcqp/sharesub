SHARESUB_HTTP_ADDR=127.0.0.1:8080
SHARESUB_DATABASE_URL=postgres://sharesub:sharesub@127.0.0.1:5432/sharesub?sslmode=disable
SHARESUB_PUBLIC_URL=http://127.0.0.1:5173
# Docker 部署的公开地址；生产环境改为独立的 HTTPS 子域名
SHARESUB_DOCKER_PUBLIC_URL=http://127.0.0.1:8081
# Docker Web 只监听回环地址，并避开 sub2api 默认使用的 8080
SHARESUB_WEB_BIND_HOST=127.0.0.1
SHARESUB_WEB_PORT=8081
# 仅 deploy/docker-compose.dev.yml 使用；生产 PostgreSQL 不映射宿主机端口
SHARESUB_DATABASE_BIND_HOST=127.0.0.1
SHARESUB_DATABASE_PORT=5432
SHARESUB_SESSION_TTL=720h
# 注册邮箱验证。留空 provider 时后端仍可启动，但注册邮件会返回不可用；生产环境应配置腾讯云 SES。
SHARESUB_EMAIL_DELIVERY_PROVIDER=
SHARESUB_TENCENT_SES_SECRET_ID=
SHARESUB_TENCENT_SES_SECRET_KEY=
SHARESUB_TENCENT_SES_REGION=ap-hongkong
SHARESUB_TENCENT_SES_FROM_EMAIL=no-reply@notify.example.com
SHARESUB_TENCENT_SES_FROM_NAME=ShareSub
SHARESUB_TENCENT_SES_TEMPLATE_ID=
SHARESUB_EMAIL_VERIFICATION_TTL=1h
SHARESUB_EMAIL_RESEND_COOLDOWN=1m
# 资源清理与历史数据保留
SHARESUB_CLEANUP_INTERVAL=6h
SHARESUB_GATEWAY_METRIC_RETENTION=2160h
SHARESUB_GATEWAY_MAX_REQUESTS_PER_MINUTE_PER_API_KEY=300
SHARESUB_GATEWAY_FIRST_OUTPUT_TIMEOUT=2m
SHARESUB_AUDIT_EVENT_RETENTION=8760h
SHARESUB_READ_NOTIFICATION_RETENTION=2160h
SHARESUB_TERMINAL_RECORD_RETENTION=2160h
# OpenAI OAuth access token 自动刷新
SHARESUB_TOKEN_REFRESH_ENABLED=true
SHARESUB_TOKEN_REFRESH_INTERVAL=5m
SHARESUB_TOKEN_REFRESH_BEFORE_EXPIRY=30m
SHARESUB_TOKEN_REFRESH_BATCH_SIZE=200
SHARESUB_TOKEN_REFRESH_CONCURRENCY=4
SHARESUB_TOKEN_REFRESH_MAX_RETRIES=3
# Responses WebSocket v2 生命周期、连接数与单帧限制
SHARESUB_RESPONSES_WS_FIRST_MESSAGE_TIMEOUT=30s
SHARESUB_RESPONSES_WS_INTER_TURN_IDLE_TIMEOUT=5m
SHARESUB_RESPONSES_WS_MAX_SESSION_DURATION=1h
SHARESUB_RESPONSES_WS_MAX_CONNECTIONS_PER_API_KEY=64
SHARESUB_RESPONSES_WS_DIAL_TIMEOUT=10s
SHARESUB_RESPONSES_WS_READ_TIMEOUT=15m
SHARESUB_RESPONSES_WS_WRITE_TIMEOUT=2m
SHARESUB_RESPONSES_WS_UPSTREAM_DRAIN_TIMEOUT=1.2s
SHARESUB_RESPONSES_WS_CLIENT_READ_LIMIT_BYTES=67108864
SHARESUB_RESPONSES_WS_UPSTREAM_READ_LIMIT_BYTES=16777216
# Docker 资源上限
SHARESUB_API_MEMORY_LIMIT=1g
SHARESUB_API_CPU_LIMIT=2
SHARESUB_WEB_MEMORY_LIMIT=256m
SHARESUB_WEB_CPU_LIMIT=0.5
SHARESUB_POSTGRES_MEMORY_LIMIT=1g
SHARESUB_POSTGRES_CPU_LIMIT=2
SHARESUB_OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
# OpenAI 直连不可用时填写 HTTP、HTTPS 或 SOCKS5 代理地址
SHARESUB_OUTBOUND_PROXY=
# 两个值必须分别执行 openssl rand -base64 32 生成
SHARESUB_TOKEN_PEPPER=
SHARESUB_CREDENTIAL_KEY=
